PATH="@abs_top_builddir@/libcob/.libs:${PATH}"
PATH="@abs_top_builddir@/cobc:@abs_top_builddir@/bin:${PATH}"
export PATH


# let atlocal know that there's less to setup
GNUCOBOL_ENV_SETUP=1
export GNUCOBOL_ENV_SETUP

# entries likely referenced in the LIBS entries as shell variables below
prefix="@prefix@"
exec_prefix="@exec_prefix@"

# get path without quote and possibly translated (MSYS) for running in an
# environment that doesn't match the one where the binaries were built
_return_path () {
	if test "x$MSYSTEM" = x; then
		path="$1"
	else
		# note: we get forward slashes here, and may also quotes,
		#       which we already add from the outsiode
		path=$(cmd //c echo "$1")
	fi
	path="${path#\"}"
	path="${path%\"}"
	echo "$path"
}

# options that are also used in atlocal (always add to both)
COB_CFLAGS="-I\"$(_return_path "@abs_top_srcdir@")\" @COB_CFLAGS@ ${COB_CFLAGS}"
COB_LDFLAGS="@COB_LDFLAGS@ ${COB_LDFLAGS}"
COB_LIBS="-L\"$(_return_path "@abs_top_builddir@/libcob/.libs")\" @COB_LIBS@ ${COB_LIBS}"
COB_CONFIG_DIR="$(_return_path "@abs_top_srcdir@/config")"
COB_COPY_DIR="$(_return_path "@abs_top_srcdir@/copy")"
LD_LIBRARY_PATH="@abs_top_builddir@/libcob/.libs:${LD_LIBRARY_PATH}"     # GNU/Linux, Solaris, ...
DYLD_LIBRARY_PATH="@abs_top_builddir@/libcob/.libs:{$DYLD_LIBRARY_PATH}" # Mac OS
SHLIB_PATH="@abs_top_builddir@/libcob/.libs:${SHLIB_PATH}"               # HP-UX
LIBPATH="@abs_top_builddir@/libcob/.libs:${LIBPATH}"                     # AIX
if [ -z "${COB_LIBRARY_PATH}" ]; then
	COB_LIBRARY_PATH="$(_return_path "@abs_top_builddir@/extras")"
else
	# only in pre-inst case: prepend
	COB_LIBRARY_PATH="$(_return_path "@abs_top_builddir@/extras:${COB_LIBRARY_PATH}")"
fi
if [ -z "${COB_SCHEMA_DIR}" ]; then
	# Note: COB_SCHEMA_DIR is unchanged - if set - by purpose in pre-inst env
	COB_SCHEMA_DIR="$(_return_path "@datarootdir@/schema")"; export COB_SCHEMA_DIR
fi

export COB_CFLAGS COB_LDFLAGS COB_LIBS
export COB_CONFIG_DIR COB_COPY_DIR
export LD_LIBRARY_PATH DYLD_LIBRARY_PATH SHLIB_PATH LIBPATH
export COB_LIBRARY_PATH

# not robust check, and only works for GNU bash; but much better than none
if test "x${BASH_SOURCE}" != "x" -a "${BASH_SOURCE}" != "$0"; then
	echo "This script should not be sourced but called instead!"
else
	if [ -z "$1" ]; then
		$SHELL
	else
		exec "$@"
	fi
fi
