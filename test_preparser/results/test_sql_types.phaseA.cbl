       IDENTIFICATION DIVISION.
       PROGRAM-ID. TEST-SQL-TYPES.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. IBM-AT.
       OBJECT-COMPUTER. IBM-AT.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.

       DATA DIVISION.
       FILE SECTION.

       WORKING-STORAGE SECTION.

GIXSQL*    01 BFLD  SQL TYPE IS BINARY(100).
GIXSQL     01 BFLD PIC X(100).
GIXSQL*    01 VBFLD SQL TYPE IS VARBINARY(100).
GIXSQL     01 VBFLD.
GIXSQL         49 VBFLD-LEN PIC 9(8) COMP-5.
GIXSQL         49 VBFLD-ARR PIC X(100).

GIXSQL*    01 CFLD  SQL TYPE IS CHAR(100).
GIXSQL     01 CFLD PIC X(100).

GIXSQL*    01 VCFLD PIC X(100) VARYING.
GIXSQL     01 VCFLD.
GIXSQL         49 VCFLD-LEN PIC 9(8) COMP-5.
GIXSQL         49 VCFLD-ARR PIC X(100).

           01 DATASRC PIC X(64).
           01 DBUSR   PIC X(64).

GIXSQL*EXEC SQL
GIXSQL*     INCLUDE SQLCA
GIXSQL*END-EXEC.
           COPY SQLCA.
GIXSQL*
GIXSQL*   ESQL CURSOR INIT FLAGS (START)
GIXSQL*   ESQL CURSOR INIT FLAGS (END)
       PROCEDURE DIVISION.

       000-CONNECT.
           DISPLAY "DATASRC" UPON ENVIRONMENT-NAME.
           ACCEPT DATASRC FROM ENVIRONMENT-VALUE.
           DISPLAY "DATASRC_USR" UPON ENVIRONMENT-NAME.
           ACCEPT DBUSR FROM ENVIRONMENT-VALUE.

GIXSQL*    EXEC SQL
GIXSQL*       CONNECT TO :DATASRC USER :DBUSR
GIXSQL*    END-EXEC.
GIXSQL     CALL "GIXSQLConnect" USING
GIXSQL         BY REFERENCE SQLCA
GIXSQL         BY REFERENCE DATASRC
GIXSQL         BY VALUE 64
GIXSQL         BY REFERENCE x"00"
GIXSQL         BY VALUE 0
GIXSQL         BY REFERENCE x"00"
GIXSQL         BY VALUE 0
GIXSQL         BY REFERENCE DBUSR
GIXSQL         BY VALUE 64
GIXSQL         BY REFERENCE x"00"
GIXSQL         BY VALUE 0
GIXSQL     END-CALL.

           IF SQLCODE NOT = 0 THEN
              DISPLAY 'CONNECT FAILED: ' SQLCODE
              GO TO 999-EXIT
           END-IF.

       100-MAIN.
           DISPLAY 'SQL TYPES TEST'.

GIXSQL*    EXEC SQL CONNECT RESET END-EXEC.
GIXSQL     CALL "GIXSQLConnectReset" USING
GIXSQL         BY REFERENCE SQLCA
GIXSQL         BY REFERENCE x"00"
GIXSQL         BY VALUE 0
GIXSQL     END-CALL.

       999-EXIT.
           STOP RUN.
GIXSQL*
GIXSQL*   ESQL CURSOR DECLARATIONS (START)
GIXSQL     GO TO GIX-SKIP-CRSR-INIT.
GIXSQL GIX-SKIP-CRSR-INIT.
GIXSQL*
GIXSQL*   ESQL CURSOR DECLARATIONS (END)
