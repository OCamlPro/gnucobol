 01 GIXSQL-CI-F-test-cursor-operations-EMPCUR PIC X.

 PROCEDURE DIVISION.

 000-CONNECT.
 DISPLAY "DATASRC" UPON ENVIRONMENT-NAME.
 ACCEPT DATASRC FROM ENVIRONMENT-VALUE.
 DISPLAY "DATASRC_USR" UPON ENVIRONMENT-NAME.
 ACCEPT DBUSR FROM ENVIRONMENT-VALUE.
 DISPLAY "DATASRC_PWD" UPON ENVIRONMENT-NAME.
 ACCEPT DBPWD FROM ENVIRONMENT-VALUE.




 CALL "GIXSQLConnect" USING
 BY REFERENCE SQLCA
 BY REFERENCE DATASRC
 BY VALUE 64
 BY REFERENCE x"00" 
 BY VALUE 0
 BY REFERENCE x"00" 
 BY VALUE 0
 BY REFERENCE DBUSR
 BY VALUE 64
 BY REFERENCE DBPWD
 BY VALUE 64
 END-CALL.

 IF SQLCODE NOT = 0 THEN
 DISPLAY 'CONNECT FAILED: ' SQLCODE
 GO TO 999-EXIT
 END-IF.

 100-DECLARE-CURSOR.






 IF GIXSQL-CI-F-test-cursor-operations-EMPCUR = ' ' THEN
 PERFORM GIXSQL-CI-P-test-cursor-operations-EMPCUR
 IF SQLCODE = 0
 MOVE 'X' TO GIXSQL-CI-F-test-cursor-operations-EMPCUR
 END-IF
 ELSE
 MOVE 0 TO SQLCODE
 END-IF

 200-OPEN-CURSOR.



 IF GIXSQL-CI-F-test-cursor-operations-EMPCUR = ' ' THEN
 PERFORM GIXSQL-CI-P-test-cursor-operations-EMPCUR
 IF SQLCODE = 0
 MOVE 'X' TO GIXSQL-CI-F-test-cursor-operations-EMPCUR
 END-IF
 END-IF
 IF GIXSQL-CI-F-test-cursor-operations-EMPCUR = 'X' THEN
 CALL "GIXSQLCursorOpen" USING
 BY REFERENCE SQLCA
 BY REFERENCE "test_cursor_operations_EMPCUR" & x"00" 
 END-CALL
 END-IF.

 DISPLAY 'OPEN CURSOR SQLCODE: ' SQLCODE.

 300-FETCH-LOOP.



 CALL "GIXSQLStartSQL" 
 END-CALL
 CALL "GIXSQLSetResultParams" USING
 BY VALUE 23
 BY VALUE 4
 BY VALUE 0
 BY VALUE 256
 BY REFERENCE ENO
 BY REFERENCE 0
 END-CALL
 CALL "GIXSQLSetResultParams" USING
 BY VALUE 16
 BY VALUE 10
 BY VALUE 0
 BY VALUE 0
 BY REFERENCE LNAME
 BY REFERENCE 0
 END-CALL
 CALL "GIXSQLSetResultParams" USING
 BY VALUE 16
 BY VALUE 10
 BY VALUE 0
 BY VALUE 0
 BY REFERENCE FNAME
 BY REFERENCE 0
 END-CALL
 CALL "GIXSQLCursorFetchOne" USING
 BY REFERENCE SQLCA
 BY REFERENCE "test_cursor_operations_EMPCUR" & x"00" 
 END-CALL
 CALL "GIXSQLEndSQL" 
 END-CALL.

 IF SQLCODE NOT = 0 THEN
 DISPLAY 'FETCH DONE. ROWS: ' FETCH-COUNT
 GO TO 400-CLOSE-CURSOR
 END-IF.

 ADD 1 TO FETCH-COUNT.
 DISPLAY 'ROW ' FETCH-COUNT ': ' ENO ' ' LNAME ' ' 
 FNAME.
 GO TO 300-FETCH-LOOP.

 400-CLOSE-CURSOR.



 CALL "GIXSQLCursorClose" USING
 BY REFERENCE SQLCA
 BY REFERENCE "test_cursor_operations_EMPCUR" & x"00" 
 END-CALL.

 DISPLAY 'CLOSE CURSOR SQLCODE: ' SQLCODE.


 CALL "GIXSQLConnectReset" USING
 BY REFERENCE SQLCA
 BY REFERENCE x"00" 
 BY VALUE 0
 END-CALL.

 999-EXIT.
 STOP RUN.


 GO TO GIX-SKIP-CRSR-INIT.
 GIXSQL-CI-P-test-cursor-operations-EMPCUR.
 CALL "GIXSQLCursorDeclare" USING
 BY REFERENCE SQLCA
 BY REFERENCE x"00" 
 BY VALUE 0
 BY REFERENCE "test_cursor_operations_EMPCUR" & x"00" 
 BY VALUE 0
 BY REFERENCE SQ0001
 BY VALUE 0
 END-CALL.
 GIX-SKIP-CRSR-INIT.


