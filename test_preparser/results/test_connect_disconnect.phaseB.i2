 PROCEDURE DIVISION.

 000-CONNECT.
 DISPLAY "DATASRC" UPON ENVIRONMENT-NAME.
 ACCEPT DATASRC FROM ENVIRONMENT-VALUE.
 DISPLAY "DATASRC_USR" UPON ENVIRONMENT-NAME.
 ACCEPT DBUSR FROM ENVIRONMENT-VALUE.
 DISPLAY "DATASRC_PWD" UPON ENVIRONMENT-NAME.
 ACCEPT DBPWD FROM ENVIRONMENT-VALUE.

 DISPLAY '**** CONNECTING ****'.
 DISPLAY ' DATASRC: ' DATASRC.




 CALL "GIXSQLConnect" USING
 BY REFERENCE SQLCA
 BY REFERENCE DATASRC
 BY VALUE 64
 BY REFERENCE x"00" 
 BY VALUE 0
 BY REFERENCE x"00" 
 BY VALUE 0
 BY REFERENCE DBUSR
 BY VALUE 64
 BY REFERENCE DBPWD
 BY VALUE 64
 END-CALL.

 DISPLAY 'CONNECT SQLCODE: ' SQLCODE.

 IF SQLCODE NOT = 0 THEN
 GO TO 999-EXIT
 END-IF.

 100-DISCONNECT.
 DISPLAY '**** DISCONNECTING ****'.


 CALL "GIXSQLConnectReset" USING
 BY REFERENCE SQLCA
 BY REFERENCE x"00" 
 BY VALUE 0
 END-CALL.

 DISPLAY 'DISCONNECT SQLCODE: ' SQLCODE.

 999-EXIT.
 STOP RUN.


 GO TO GIX-SKIP-CRSR-INIT.
 GIX-SKIP-CRSR-INIT.


