       IDENTIFICATION DIVISION.
       PROGRAM-ID. TEST-CURSOR-OPS.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. IBM-AT.
       OBJECT-COMPUTER. IBM-AT.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.

       DATA DIVISION.
       FILE SECTION.

       WORKING-STORAGE SECTION.

GIXSQL*EXEC SQL
GIXSQL* INCLUDE EMPREC
GIXSQL*END-EXEC.
           COPY EMPREC.

           01 DATASRC PIC X(64).
           01 DBUSR   PIC X(64).
           01 DBPWD   PIC X(64).
           01 FETCH-COUNT PIC 9(4) VALUE 0.

GIXSQL*EXEC SQL
GIXSQL*     INCLUDE SQLCA
GIXSQL*END-EXEC.
           COPY SQLCA.
GIXSQL*
GIXSQL 01  SQ0001.
GIXSQL     02  FILLER PIC X(0053) VALUE "SELECT ENO , LNAME , FNAME FR"
GIXSQL  &  "OM EMPTABLE ORDER BY ENO".
GIXSQL     02  FILLER PIC X(1) VALUE X"00".
GIXSQL*   ESQL CURSOR INIT FLAGS (START)
GIXSQL 01  GIXSQL-CI-F-test-cursor-operations-EMPCUR PIC X.
GIXSQL*   ESQL CURSOR INIT FLAGS (END)
       PROCEDURE DIVISION.

       000-CONNECT.
           DISPLAY "DATASRC" UPON ENVIRONMENT-NAME.
           ACCEPT DATASRC FROM ENVIRONMENT-VALUE.
           DISPLAY "DATASRC_USR" UPON ENVIRONMENT-NAME.
           ACCEPT DBUSR FROM ENVIRONMENT-VALUE.
           DISPLAY "DATASRC_PWD" UPON ENVIRONMENT-NAME.
           ACCEPT DBPWD FROM ENVIRONMENT-VALUE.

GIXSQL*    EXEC SQL
GIXSQL*       CONNECT TO :DATASRC USER :DBUSR USING :DBPWD
GIXSQL*    END-EXEC.
GIXSQL     CALL "GIXSQLConnect" USING
GIXSQL         BY REFERENCE SQLCA
GIXSQL         BY REFERENCE DATASRC
GIXSQL         BY VALUE 64
GIXSQL         BY REFERENCE x"00"
GIXSQL         BY VALUE 0
GIXSQL         BY REFERENCE x"00"
GIXSQL         BY VALUE 0
GIXSQL         BY REFERENCE DBUSR
GIXSQL         BY VALUE 64
GIXSQL         BY REFERENCE DBPWD
GIXSQL         BY VALUE 64
GIXSQL     END-CALL.

           IF SQLCODE NOT = 0 THEN
              DISPLAY 'CONNECT FAILED: ' SQLCODE
              GO TO 999-EXIT
           END-IF.

       100-DECLARE-CURSOR.
GIXSQL*    EXEC SQL
GIXSQL*        DECLARE EMPCUR CURSOR FOR
GIXSQL*            SELECT ENO, LNAME, FNAME
GIXSQL*            FROM EMPTABLE
GIXSQL*            ORDER BY ENO
GIXSQL*    END-EXEC.
GIXSQL     IF GIXSQL-CI-F-test-cursor-operations-EMPCUR = ' ' THEN
GIXSQL         PERFORM GIXSQL-CI-P-test-cursor-operations-EMPCUR
GIXSQL         IF SQLCODE = 0
GIXSQL           MOVE 'X' TO GIXSQL-CI-F-test-cursor-operations-EMPCUR
GIXSQL         END-IF
GIXSQL     ELSE
GIXSQL         MOVE 0 TO SQLCODE
GIXSQL     END-IF

       200-OPEN-CURSOR.
GIXSQL*    EXEC SQL
GIXSQL*        OPEN EMPCUR
GIXSQL*    END-EXEC.
GIXSQL     IF GIXSQL-CI-F-test-cursor-operations-EMPCUR = ' ' THEN
GIXSQL         PERFORM GIXSQL-CI-P-test-cursor-operations-EMPCUR
GIXSQL         IF SQLCODE = 0
GIXSQL           MOVE 'X' TO GIXSQL-CI-F-test-cursor-operations-EMPCUR
GIXSQL         END-IF
GIXSQL     END-IF
GIXSQL     IF GIXSQL-CI-F-test-cursor-operations-EMPCUR = 'X' THEN
GIXSQL         CALL "GIXSQLCursorOpen" USING
GIXSQL             BY REFERENCE SQLCA
GIXSQL             BY REFERENCE "test_cursor_operations_EMPCUR" & x"00"
GIXSQL         END-CALL
GIXSQL     END-IF.

           DISPLAY 'OPEN CURSOR SQLCODE: ' SQLCODE.

       300-FETCH-LOOP.
GIXSQL*    EXEC SQL
GIXSQL*        FETCH EMPCUR INTO :ENO, :LNAME, :FNAME
GIXSQL*    END-EXEC.
GIXSQL     CALL "GIXSQLStartSQL"
GIXSQL     END-CALL
GIXSQL     CALL "GIXSQLSetResultParams" USING
GIXSQL         BY VALUE 23
GIXSQL         BY VALUE 4
GIXSQL         BY VALUE 0
GIXSQL         BY VALUE 256
GIXSQL         BY REFERENCE ENO
GIXSQL         BY REFERENCE 0
GIXSQL     END-CALL
GIXSQL     CALL "GIXSQLSetResultParams" USING
GIXSQL         BY VALUE 16
GIXSQL         BY VALUE 10
GIXSQL         BY VALUE 0
GIXSQL         BY VALUE 0
GIXSQL         BY REFERENCE LNAME
GIXSQL         BY REFERENCE 0
GIXSQL     END-CALL
GIXSQL     CALL "GIXSQLSetResultParams" USING
GIXSQL         BY VALUE 16
GIXSQL         BY VALUE 10
GIXSQL         BY VALUE 0
GIXSQL         BY VALUE 0
GIXSQL         BY REFERENCE FNAME
GIXSQL         BY REFERENCE 0
GIXSQL     END-CALL
GIXSQL     CALL "GIXSQLCursorFetchOne" USING
GIXSQL         BY REFERENCE SQLCA
GIXSQL         BY REFERENCE "test_cursor_operations_EMPCUR" & x"00"
GIXSQL     END-CALL
GIXSQL     CALL "GIXSQLEndSQL"
GIXSQL     END-CALL.

           IF SQLCODE NOT = 0 THEN
              DISPLAY 'FETCH DONE. ROWS: ' FETCH-COUNT
              GO TO 400-CLOSE-CURSOR
           END-IF.

           ADD 1 TO FETCH-COUNT.
           DISPLAY 'ROW ' FETCH-COUNT ': ' ENO ' ' LNAME ' '
                   FNAME.
           GO TO 300-FETCH-LOOP.

       400-CLOSE-CURSOR.
GIXSQL*    EXEC SQL
GIXSQL*        CLOSE EMPCUR
GIXSQL*    END-EXEC.
GIXSQL     CALL "GIXSQLCursorClose" USING
GIXSQL         BY REFERENCE SQLCA
GIXSQL         BY REFERENCE "test_cursor_operations_EMPCUR" & x"00"
GIXSQL     END-CALL.

           DISPLAY 'CLOSE CURSOR SQLCODE: ' SQLCODE.

GIXSQL*    EXEC SQL CONNECT RESET END-EXEC.
GIXSQL     CALL "GIXSQLConnectReset" USING
GIXSQL         BY REFERENCE SQLCA
GIXSQL         BY REFERENCE x"00"
GIXSQL         BY VALUE 0
GIXSQL     END-CALL.

       999-EXIT.
           STOP RUN.
GIXSQL*
GIXSQL*   ESQL CURSOR DECLARATIONS (START)
GIXSQL     GO TO GIX-SKIP-CRSR-INIT.
GIXSQL GIXSQL-CI-P-test-cursor-operations-EMPCUR.
GIXSQL     CALL "GIXSQLCursorDeclare" USING
GIXSQL         BY REFERENCE SQLCA
GIXSQL         BY REFERENCE x"00"
GIXSQL         BY VALUE 0
GIXSQL         BY REFERENCE "test_cursor_operations_EMPCUR" & x"00"
GIXSQL         BY VALUE 0
GIXSQL         BY REFERENCE SQ0001
GIXSQL         BY VALUE 0
GIXSQL     END-CALL.
GIXSQL GIX-SKIP-CRSR-INIT.
GIXSQL*
GIXSQL*   ESQL CURSOR DECLARATIONS (END)
