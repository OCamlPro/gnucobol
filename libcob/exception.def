/* COB_EXCEPTION (code, tag, name, fatal) */

#ifndef COB_EXCEPTION
	#define DUMMY_ENUM
	#define	COB_EXCEPTION(code,tag,name,fatal) tag = (code) + sizeof(name) + fatal,
	/* dummy-definition for lsp-supported editors */
	enum exception_dummy {
#endif


/* All exceptions */
COB_EXCEPTION  (COB_EC_CODE_ALL, COB_EC_ALL,
		"EC-ALL", 0)


/* Argument error */
COB_EXCEPTION  (COB_EC_GROUP (0x01), COB_EC_ARGUMENT,
		"EC-ARGUMENT", 0)

/* Function argument error */
COB_EXCEPTION  (COB_EC_CODE (0x01, 1), COB_EC_ARGUMENT_FUNCTION,
		"EC-ARGUMENT-FUNCTION", 1)

/* Implementation-defined argument error */
COB_EXCEPTION  (COB_EC_CODE (0x01, 2), COB_EC_ARGUMENT_IMP,
		"EC-ARGUMENT-IMP", 0)


/* Boundary violation */
COB_EXCEPTION  (COB_EC_GROUP (0x02), COB_EC_BOUND,
		"EC-BOUND", 0)

/* Return of intrinsic does not fit into temporary item (COBOL 202x) */
COB_EXCEPTION  (COB_EC_CODE (0x02, 9), COB_EC_RET_VALUE,
		"EC-BOUND-FUNC-RET-VALUE", 0)

/* Implementation-defined boundary violation */
COB_EXCEPTION  (COB_EC_CODE (0x02, 1), COB_EC_BOUND_IMP,
		"EC-BOUND-IMP", 0)

/* OCCURS ... DEPENDING ON data item out of bounds */
COB_EXCEPTION  (COB_EC_CODE (0x02, 2), COB_EC_BOUND_ODO,
		"EC-BOUND-ODO", 1)

/* Dynamic table capacity exceeded expected value (COBOL 2014) */
COB_EXCEPTION  (COB_EC_CODE (0x02, 3), COB_EC_BOUND_OVERFLOW,
		"EC-BOUND-OVERFLOW", 1)

/* Data-pointer contains an address that is out of bounds */
COB_EXCEPTION  (COB_EC_CODE (0x02, 4), COB_EC_BOUND_PTR,
		"EC-BOUND-PTR", 1)

/* Reference modifier out of bounds */
COB_EXCEPTION  (COB_EC_CODE (0x02, 5), COB_EC_BOUND_REF_MOD,
		"EC-BOUND-REF-MOD", 1)

/* Invalid SET of dynamic table capacity (COBOL 2014) */
COB_EXCEPTION  (COB_EC_CODE (0x02, 6), COB_EC_BOUND_SET,
		"EC-BOUND-SET", 1)

/* Subscript out of bounds */
COB_EXCEPTION  (COB_EC_CODE (0x02, 7), COB_EC_BOUND_SUBSCRIPT,
		"EC-BOUND-SUBSCRIPT", 1)

/* Dynamic table capacity exceeded maximum size (COBOL 2014) */
COB_EXCEPTION  (COB_EC_CODE (0x02, 8), COB_EC_BOUND_TABLE_LIMIT,
		"EC-BOUND-TABLE-LIMIT", 1)


/* CONTINUE exception (COBOL 202x) */
COB_EXCEPTION  (COB_EC_GROUP (0x18), COB_EC_CONTINUE,
		"EC-CONTINUE", 0)

/* Implementation-defined CONTINUE exception (like max-exceeded) */
COB_EXCEPTION  (COB_EC_CODE (0x18, 1), COB_EC_CONTINUE_IMP,
		"EC-CONTINUE-IMP", 0)

/* Incompatible data exception */
COB_EXCEPTION  (COB_EC_CODE (0x18, 2), COB_EC_CONTINUE_LESS_THAN_ZERO,
		"EC-CONTINUE-LESS-THAN-ZERO", 0)


/* Data exception */
COB_EXCEPTION  (COB_EC_GROUP (0x03), COB_EC_DATA,
		"EC-DATA", 0)

/* Conversion failed because of incomplete character correspondence */
COB_EXCEPTION  (COB_EC_CODE (0x03, 1), COB_EC_DATA_CONVERSION,
		"EC-DATA-CONVERSION", 0)

/* Implementation-defined data exception */
COB_EXCEPTION  (COB_EC_CODE (0x03, 2), COB_EC_DATA_IMP,
		"EC-DATA-IMP", 0)

/* Incompatible data exception */
COB_EXCEPTION  (COB_EC_CODE (0x03, 3), COB_EC_DATA_INCOMPATIBLE,
		"EC-DATA-INCOMPATIBLE", 1)

/* Using floating-point usage data item which is NaN or an infinity */
COB_EXCEPTION  (COB_EC_CODE (0x03, 4), COB_EC_DATA_NOT_FINITE,
		"EC-DATA-NOT-FINITE", 1)

/* Exponent overflow during MOVE to item with floating-point usage */
COB_EXCEPTION  (COB_EC_CODE (0x03, 5), COB_EC_DATA_OVERFLOW,
		"EC-DATA-OVERFLOW", 1)

/* Based item data-pointer is set to NULL when referenced */
COB_EXCEPTION  (COB_EC_CODE (0x03, 6), COB_EC_DATA_PTR_NULL,
		"EC-DATA-PTR-NULL", 1)

/* Attempt to use a null valued data item in a context where not permitted (COBOL2025) */
COB_EXCEPTION  (COB_EC_CODE (0x03, 7), COB_EC_DATA_NULL,
		"EC-DATA-NULL", 1)

/* A non-space or significant-digit was truncated during MOVE (COBOL2025) */
COB_EXCEPTION  (COB_EC_CODE (0x03, 8), COB_EC_DATA_TRUNCATION,
		"EC-DATA-TRUNCATION", 0)



/* EXTERNAL item mismatch (COBOL 202x) */
COB_EXCEPTION  (COB_EC_GROUP (0x19), COB_EC_EXTERNAL,
		"EC-EXTERNAL", 0)

/* File referencing control item conflict because the linage, file status
   or relative key references are not to the same item in storage for each
   runtime element for an external file */
COB_EXCEPTION  (COB_EC_CODE (0x19, 1), COB_EC_DATA_MISMATCH,
		"EC-EXTERNAL-DATA-MISMATCH", 1)

/* File control SELECT statements are not compatible */
COB_EXCEPTION  (COB_EC_CODE (0x19, 2), COB_EC_FILE_MISMATCH,
		"EC-EXTERNAL-FILE-MISMATCH", 1)

/* EXTERNAL data items do not conform to each other */
COB_EXCEPTION  (COB_EC_CODE (0x19, 3), COB_EC_EXTERNAL_FORMAT_CONFLICT,
		"EC-EXTERNAL-FORMAT-CONFLICT", 1)

/* Implementation-defined EXTERNAL item mismatch */
COB_EXCEPTION  (COB_EC_CODE (0x19, 4), COB_EC_EXTERNAL_IMP,
		"EC-EXTERNAL-IMP", 0)


/* DELETE FILE exception */
COB_EXCEPTION  (COB_EC_GROUP (0x20), COB_EC_DELETE_FILE, /* was 1800 */
		"EC-DELETE-FILE", 0)

/* DELETE FILE exception */
COB_EXCEPTION  (COB_EC_CODE (0x20, 16), COB_EC_DELETE_FILE_IMP, /* was 1810 */
		"EC-DELETE-FILE-IMP", 0)


/* Execution control flow violation */
COB_EXCEPTION  (COB_EC_GROUP (0x04), COB_EC_FLOW,
		"EC-FLOW", 0)

/* Invocation of a runtime element with an APPLY COMMIT clause in effect
   by a runtime element for which commit and  rollback is not permitted.
   An attempt to change the address of a data item subject to an
   APPLY COMMIT clause. (COBOL 202x) */
COB_EXCEPTION  (COB_EC_CODE (0x04, 10), COB_EC_FLOW_APPLY_COMMIT,
		"EC-FLOW-APPLY-COMMIT", 1)

/* Invocation of a COMMIT statement where it is not permitted. (COBOL 202x) */
COB_EXCEPTION  (COB_EC_CODE (0x04, 11), COB_EC_FLOW_COMMIT,
		"EC-FLOW-COMMIT", 1)

/* EXIT PROGRAM in a global declarative */
COB_EXCEPTION  (COB_EC_CODE (0x04, 1), COB_EC_FLOW_GLOBAL_EXIT,
		"EC-FLOW-GLOBAL-EXIT", 1)

/* GOBACK in a global declarative */
COB_EXCEPTION  (COB_EC_CODE (0x04, 2), COB_EC_FLOW_GLOBAL_GOBACK,
		"EC-FLOW-GLOBAL-GOBACK", 1)

/* Implementation-defined control flow violation */
COB_EXCEPTION  (COB_EC_CODE (0x04, 3), COB_EC_FLOW_IMP,
		"EC-FLOW-IMP", 0)

/* RELEASE not in range of SORT */
COB_EXCEPTION  (COB_EC_CODE (0x04, 4), COB_EC_FLOW_RELEASE,
		"EC-FLOW-RELEASE", 1)

/* GENERATE, INITIATE, or TERMINATE during USE BEFORE REPORTING declarative */
COB_EXCEPTION  (COB_EC_CODE (0x04, 5), COB_EC_FLOW_REPORT,
		"EC-FLOW-REPORT", 1)

/* RETURN not in range of MERGE or SORT */
COB_EXCEPTION  (COB_EC_CODE (0x04, 6), COB_EC_FLOW_RETURN,
		"EC-FLOW-RETURN", 1)

/* Invocation of a ROLLBACK statement where it is not permitted. (COBOL 202x) */
COB_EXCEPTION  (COB_EC_CODE (0x04, 12), COB_EC_FLOW_ROLLBACK,
		"EC-FLOW-ROLLBACK", 1)

/* Invalid use of SET for dynamic table */
COB_EXCEPTION  (COB_EC_CODE (0x04, 7), COB_EC_FLOW_SEARCH,
		"EC-FLOW-SEARCH", 1)

/* A USE statement caused another to be executed */
COB_EXCEPTION  (COB_EC_CODE (0x04, 8), COB_EC_FLOW_USE,
		"EC-FLOW-USE", 1)


/* FUNCTION exception (COBOL 2014) */
COB_EXCEPTION  (COB_EC_GROUP (0x15), COB_EC_FUNCTION,
		"EC-FUNCTION", 0)

/* FUNCTION with missing argument (2014,
   previously COB_EC_PROGRAM_ARG_OMITTED) */
COB_EXCEPTION  (COB_EC_CODE (0x15, 3), COB_EC_FUNCTION_ARG_OMITTED,
		"EC-FUNCTION-ARG-OMITTED", 1)

/* Implementation-defined FUNCTION exception (COBOL 202x) */
COB_EXCEPTION  (COB_EC_CODE (0x15, 5), COB_EC_FUNCTION_IMP,
		"EC-FUNCTION-IMP", 0)

/* FUNCTION not found exception (2014,
   previously COB_EC_PROGRAM_NOT_FOUND) */
COB_EXCEPTION  (COB_EC_CODE (0x15, 4), COB_EC_FUNCTION_NOT_FOUND,
		"EC-FUNCTION-NOT-FOUND", 1)

/* FUNCTION signature mismatch */
COB_EXCEPTION  (COB_EC_CODE (0x15, 1), COB_EC_FUNCTION_PTR_INVALID,
		"EC-FUNCTION-PTR-INVALID", 1)

/* FUNCTION pointer is NULL */
COB_EXCEPTION  (COB_EC_CODE (0x15, 2), COB_EC_FUNCTION_PTR_NULL,
		"EC-FUNCTION-PTR-NULL", 1)


/* EC-I-O --> for complete group see external definitions */
#include "exception-io.def"


/* Implementation-defined exception condition */
COB_EXCEPTION  (COB_EC_GROUP (0x06), COB_EC_IMP,
		"EC-IMP", 0)

/* Implementation-defined accept condition */
COB_EXCEPTION  (COB_EC_CODE (0x06, 1), COB_EC_IMP_ACCEPT,
		"EC-IMP-ACCEPT", 0)

/* Implementation-defined display condition */
COB_EXCEPTION  (COB_EC_CODE (0x06, 2), COB_EC_IMP_DISPLAY,
		"EC-IMP-DISPLAY", 0)

/* Current UTC time cannot be found */
COB_EXCEPTION  (COB_EC_CODE (0x06, 3), COB_EC_IMP_UTC_UNKNOWN,
		"EC-IMP-UTC-UNKNOWN", 1)

/* Implementation-defined condition for features the runtime is not configured for */
COB_EXCEPTION  (COB_EC_CODE (0x06, 4), COB_EC_IMP_FEATURE_DISABLED,
        "EC-IMP-FEATURE-DISABLED", 0)

/* Implementation-defined condition for features the runtime has no support for (yet) */
COB_EXCEPTION  (COB_EC_CODE (0x06, 5), COB_EC_IMP_FEATURE_MISSING,
        "EC-IMP-FEATURE-MISSING", 0)


/* Any locale related exception */
COB_EXCEPTION  (COB_EC_GROUP (0x07), COB_EC_LOCALE,
		"EC-LOCALE", 0)

/* Implementation-defined locale related exception */
COB_EXCEPTION  (COB_EC_CODE (0x07, 1), COB_EC_LOCALE_IMP,
		"EC-LOCALE-IMP", 0)

/* The referenced locale does not specify the expected characters in LC_COLLATE */
COB_EXCEPTION  (COB_EC_CODE (0x07, 2), COB_EC_LOCALE_INCOMPATIBLE,
		"EC-LOCALE-INCOMPATIBLE", 0)

/* Locale content is invalid or incomplete */
COB_EXCEPTION  (COB_EC_CODE (0x07, 3), COB_EC_LOCALE_INVALID,
		"EC-LOCALE-INVALID", 1)

/* Pointer does not reference a saved locale */
COB_EXCEPTION  (COB_EC_CODE (0x07, 4), COB_EC_LOCALE_INVALID_PTR,
		"EC-LOCALE-INVALID-PTR", 1)

/* The specified locale is not available */
COB_EXCEPTION  (COB_EC_CODE (0x07, 5), COB_EC_LOCALE_MISSING,
		"EC-LOCALE-MISSING", 1)

/* Digits were truncated in locale editing */
COB_EXCEPTION  (COB_EC_CODE (0x07, 6), COB_EC_LOCALE_SIZE,
		"EC-LOCALE-SIZE", 1)


/* Message control system exception (COBOL 202x) */
COB_EXCEPTION  (COB_EC_GROUP (0x1A), COB_EC_MCS,
		"EC-MCS", 0)

/* Server failed before replying to message */
COB_EXCEPTION  (COB_EC_CODE (0x1A, 1), COB_EC_MCS_ABNORMAL_TERMINATION,
		"EC-MCS-ABNORMAL-TERMINATION", 0)

/* Implementation-defined MCS exception */
COB_EXCEPTION  (COB_EC_CODE (0x1A, 2), COB_EC_MCS_IMP,
		"EC-MCS-IMP", 0)

/* Invalid tag used for SEND/RECEIVE */
COB_EXCEPTION  (COB_EC_CODE (0x1A, 3), COB_EC_MCS_INVALID_TAG,
		"EC-MCS-INVALID-TAG", 0)

/* Invalid message length used for SEND/RECEIVE */
COB_EXCEPTION  (COB_EC_CODE (0x1A, 4), COB_EC_MCS_MESSAGE_LENGTH,
		"EC-MCS-MESSAGE-LENGTH", 0)

/* ... during RECEIVE statement */
COB_EXCEPTION  (COB_EC_CODE (0x1A, 5), COB_EC_NO_REQUESTER,
		"EC-MCS-NO-REQUESTER", 0)

	/* ... during SEND statement */
COB_EXCEPTION  (COB_EC_CODE (0x1A, 6), COB_EC_NO_SERVER,
		"EC-MCS-NO-SERVER", 0)

/* Server terminated before replying to message */
COB_EXCEPTION  (COB_EC_CODE (0x1A, 7), COB_EC_MCS_NORMAL_TERMINATION,
		"EC-MCS-NORMAL-TERMINATION", 0)

/* ... during RECEIVE statement */
COB_EXCEPTION  (COB_EC_CODE (0x1A, 8), COB_EC_MCS_REQUESTOR_FAILED,
		"EC-MCS-REQUESTOR-FAILED", 0)


/* Any predefined OO related exception */
COB_EXCEPTION  (COB_EC_GROUP (0x08), COB_EC_OO,
		"EC-OO", 0)

/* Reference to an omitted argument (2014,
   previously COB_EC_PROGRAM_ARG_OMITTED) */
COB_EXCEPTION  (COB_EC_CODE (0x08, 3), COB_EC_OO_ARG_OMITTED,
		"EC-OO-ARG-OMITTED", 1)

/* Failure for an object-view */
COB_EXCEPTION  (COB_EC_CODE (0x08, 1), COB_EC_OO_CONFORMANCE,
		"EC-OO-CONFORMANCE", 1)

/* An exception object was not handled */
COB_EXCEPTION  (COB_EC_CODE (0x08, 2), COB_EC_OO_EXCEPTION,
		"EC-OO-EXCEPTION", 1)

/* Implementation-defined OO exception */
COB_EXCEPTION  (COB_EC_CODE (0x08, 4), COB_EC_OO_IMP,
		"EC-OO-IMP", 0)

/* Requested method is not available */
COB_EXCEPTION  (COB_EC_CODE (0x08, 5), COB_EC_OO_METHOD,
		"EC-OO-METHOD", 1)

/* Method invocation was attempted with a null object reference */
COB_EXCEPTION  (COB_EC_CODE (0x08, 6), COB_EC_OO_NULL,
		"EC-OO-NULL", 1)

/* Insufficient system resources to create the object or expand the object (COBOL2014) */
COB_EXCEPTION  (COB_EC_CODE (0x08, 7), COB_EC_OO_RESOURCE,
		"EC-OO-RESOURCE", 1)

/* A runtime type check failed */
COB_EXCEPTION  (COB_EC_CODE (0x08, 8), COB_EC_OO_UNIVERSAL,
		"EC-OO-UNIVERSAL", 1)


/* Ordering exception */
COB_EXCEPTION  (COB_EC_GROUP (0x09), COB_EC_ORDER,
		"EC-ORDER", 0)

/* Implementation-defined ordering exception */
COB_EXCEPTION  (COB_EC_CODE (0x09, 1), COB_EC_ORDER_IMP,
		"EC-ORDER-IMP", 0)

/* ISO/IEC 14651:2001 ordering table or ordering level not supported (COBOL2014) */
COB_EXCEPTION  (COB_EC_CODE (0x09, 2), COB_EC_ORDER_NOT_SUPPORTED,
		"EC-ORDER-NOT-SUPPORTED", 1)


/* Overflow condition */
COB_EXCEPTION  (COB_EC_GROUP (0x0A), COB_EC_OVERFLOW,
		"EC-OVERFLOW", 0)

/* Implementation-defined overflow condition */
COB_EXCEPTION  (COB_EC_CODE (0x0A, 1), COB_EC_OVERFLOW_IMP,
		"EC-OVERFLOW-IMP", 0)

/* STRING overflow condition */
COB_EXCEPTION  (COB_EC_CODE (0x0A, 2), COB_EC_OVERFLOW_STRING,
		"EC-OVERFLOW-STRING", 0)

/* UNSTRING overflow condition */
COB_EXCEPTION  (COB_EC_CODE (0x0A, 3), COB_EC_OVERFLOW_UNSTRING,
		"EC-OVERFLOW-UNSTRING", 0)


/* Inter-program communication exception */
COB_EXCEPTION  (COB_EC_GROUP (0x0B), COB_EC_PROGRAM,
		"EC-PROGRAM", 0)

/* Argument mismatch */
COB_EXCEPTION  (COB_EC_CODE (0x0B, 1), COB_EC_PROGRAM_ARG_MISMATCH,
		"EC-PROGRAM-ARG-MISMATCH", 1)

/* Reference to an omitted argument */
COB_EXCEPTION  (COB_EC_CODE (0x0B, 2), COB_EC_PROGRAM_ARG_OMITTED,
		"EC-PROGRAM-ARG-OMITTED", 1)

/* Canceled program active */
COB_EXCEPTION  (COB_EC_CODE (0x0B, 3), COB_EC_PROGRAM_CANCEL_ACTIVE,
		"EC-PROGRAM-CANCEL-ACTIVE", 1)

/* Implementation-defined inter-program communication exception */
COB_EXCEPTION  (COB_EC_CODE (0x0B, 4), COB_EC_PROGRAM_IMP,
		"EC-PROGRAM-IMP", 0)

/* Called program not found */
COB_EXCEPTION  (COB_EC_CODE (0x0B, 5), COB_EC_PROGRAM_NOT_FOUND,
		"EC-PROGRAM-NOT-FOUND", 1)

/* Program-pointer used in CALL is set to NULL */
COB_EXCEPTION  (COB_EC_CODE (0x0B, 6), COB_EC_PROGRAM_PTR_NULL,
		"EC-PROGRAM-PTR-NULL", 1)

/* Called program active */
COB_EXCEPTION  (COB_EC_CODE (0x0B, 7), COB_EC_PROGRAM_RECURSIVE_CALL,
		"EC-PROGRAM-RECURSIVE-CALL", 1)

/* Resources not available for called program */
COB_EXCEPTION  (COB_EC_CODE (0x0B, 8), COB_EC_PROGRAM_RESOURCES,
		"EC-PROGRAM-RESOURCES", 1)


/* EXIT ... RAISING or GOBACK RAISING exception */
COB_EXCEPTION  (COB_EC_GROUP (0x0C), COB_EC_RAISING,
		"EC-RAISING", 0)

/* Implementation-defined EXIT ... RAISING or GOBACK RAISING exception */
COB_EXCEPTION  (COB_EC_CODE (0x0C, 1), COB_EC_RAISING_IMP,
		"EC-RAISING-IMP", 0)

/* EXIT ... RAISING or GOBACK RAISING an EC-IMP or EC-USER exception
   condition not specified in RAISING phrase of procedure division header (COBOL2014) */
COB_EXCEPTION  (COB_EC_CODE (0x0C, 2), COB_EC_RAISING_NOT_SPECIFIED,
		"EC-RAISING-NOT-SPECIFIED", 1)


/* Range exception */
COB_EXCEPTION  (COB_EC_GROUP (0x0D), COB_EC_RANGE,
		"EC-RANGE", 0)

/* Implementation-defined range exception */
COB_EXCEPTION  (COB_EC_CODE (0x0D, 1), COB_EC_RANGE_IMP,
		"EC-RANGE-IMP", 0)

/* Index made negative or too large for containing variable (COBOL2014) */
COB_EXCEPTION  (COB_EC_CODE (0x0D, 2), COB_EC_RANGE_INDEX,
		"EC-RANGE-INDEX", 1)

/* Size of replace item in inspect differs */
COB_EXCEPTION  (COB_EC_CODE (0x0D, 3), COB_EC_RANGE_INSPECT_SIZE,
		"EC-RANGE-INSPECT-SIZE", 1)

/* Starting value of THROUGH range greater than ending value */
COB_EXCEPTION  (COB_EC_CODE (0x0D, 4), COB_EC_RANGE_INVALID,
		"EC-RANGE-INVALID", 0)

/* Setting of varied item in PERFORM is negative */
COB_EXCEPTION  (COB_EC_CODE (0x0D, 5), COB_EC_RANGE_PERFORM_VARYING,
		"EC-RANGE-PERFORM-VARYING", 1)

/* Pointer SET UP or DOWN is outsize range */
COB_EXCEPTION  (COB_EC_CODE (0x0D, 6), COB_EC_RANGE_PTR,
		"EC-RANGE-PTR", 1)

/* No table entry found in SEARCH because initial index out of range */
COB_EXCEPTION  (COB_EC_CODE (0x0D, 7), COB_EC_RANGE_SEARCH_INDEX,
		"EC-RANGE-SEARCH-INDEX", 0)

/* No table entry found in SEARCH because no entry matched criteria */
COB_EXCEPTION  (COB_EC_CODE (0x0D, 8), COB_EC_RANGE_SEARCH_NO_MATCH,
		"EC-RANGE-SEARCH-NO-MATCH", 0)


/* Report write exception */
COB_EXCEPTION  (COB_EC_GROUP (0x0E), COB_EC_REPORT,
		"EC-REPORT", 0)

/* INITIATE on an active report */
COB_EXCEPTION  (COB_EC_CODE (0x0E, 1), COB_EC_REPORT_ACTIVE,
		"EC-REPORT-ACTIVE", 1)

/* Overlapping report items */
COB_EXCEPTION  (COB_EC_CODE (0x0E, 2), COB_EC_REPORT_COLUMN_OVERLAP,
		"EC-REPORT-COLUMN-OVERLAP", 1)

/* INITIATE statement executed for file not opened in extend or output mode */
COB_EXCEPTION  (COB_EC_CODE (0x0E, 3), COB_EC_REPORT_FILE_MODE,
		"EC-REPORT-FILE-MODE", 1)

/* Implementation-defined report write exception */
COB_EXCEPTION  (COB_EC_CODE (0x0E, 4), COB_EC_REPORT_IMP,
		"EC-REPORT-IMP", 0)

/* GENERATE or TERMINATE on an inactive report */
COB_EXCEPTION  (COB_EC_CODE (0x0E, 5), COB_EC_REPORT_INACTIVE,
		"EC-REPORT-INACTIVE", 1)

/* Overlapping report lines */
COB_EXCEPTION  (COB_EC_CODE (0x0E, 6), COB_EC_REPORT_LINE_OVERLAP,
		"EC-REPORT-LINE-OVERLAP", 0)

/* Report file closed with active report */
COB_EXCEPTION  (COB_EC_CODE (0x0E, 8), COB_EC_REPORT_NOT_TERMINATED,
		"EC-REPORT-NOT-TERMINATED", 0)

/* Vertical page limit exceeded */
COB_EXCEPTION  (COB_EC_CODE (0x0E, 9), COB_EC_REPORT_PAGE_LIMIT,
		"EC-REPORT-PAGE-LIMIT", 0)

/* Page width exceeded */
COB_EXCEPTION  (COB_EC_CODE (0x0E, 10), COB_EC_REPORT_PAGE_WIDTH,
		"EC-REPORT-PAGE-WIDTH", 0)

/* Overflow of sum counter */
COB_EXCEPTION  (COB_EC_CODE (0x0E, 11), COB_EC_REPORT_SUM_SIZE,
		"EC-REPORT-SUM-SIZE", 1)

/* VARYING clause expression non-integer (COBOL2014) */
COB_EXCEPTION  (COB_EC_CODE (0x0E, 12), COB_EC_REPORT_VARYING,
		"EC-REPORT-VARYING", 1)


/* Screen handling exception */
COB_EXCEPTION  (COB_EC_GROUP (0x0F), COB_EC_SCREEN,
		"EC-SCREEN", 0)

/* Screen fields overlap */
COB_EXCEPTION  (COB_EC_CODE (0x0F, 1), COB_EC_SCREEN_FIELD_OVERLAP,
		"EC-SCREEN-FIELD-OVERLAP", 0)

/* Implementation-defined screen handling exception */
COB_EXCEPTION  (COB_EC_CODE (0x0F, 2), COB_EC_SCREEN_IMP,
		"EC-SCREEN-IMP", 0)

/* Screen field too long for line */
COB_EXCEPTION  (COB_EC_CODE (0x0F, 3), COB_EC_SCREEN_ITEM_TRUNCATED,
		"EC-SCREEN-ITEM-TRUNCATED", 0)

/* Screen item line number exceeds terminal size */
COB_EXCEPTION  (COB_EC_CODE (0x0F, 4), COB_EC_SCREEN_LINE_NUMBER,
		"EC-SCREEN-LINE-NUMBER", 0)

/* Screen item starting column exceeds line size */
COB_EXCEPTION  (COB_EC_CODE (0x0F, 5), COB_EC_SCREEN_STARTING_COLUMN,
		"EC-SCREEN-STARTING-COLUMN", 0)


/* Size error exception; its subordinates use one bit each, allowing codegen
   to check for all enabled ones at once (limited to 7, see TODO 3.4) */
COB_EXCEPTION  (COB_EC_GROUP (0x10), COB_EC_SIZE,
		"EC-SIZE", 0)

/* Invalid pointer arithmetic */
COB_EXCEPTION  (COB_EC_CODE (0x10, 1), COB_EC_SIZE_ADDRESS,
		"EC-SIZE-ADDRESS", 1)

/* Exponentiation rules violated */
COB_EXCEPTION  (COB_EC_CODE (0x10, 2), COB_EC_SIZE_EXPONENTIATION,
		"EC-SIZE-EXPONENTIATION", 1)

/* Implementation-defined size error exception */
COB_EXCEPTION  (COB_EC_CODE (0x10, 3), COB_EC_SIZE_IMP,
		"EC-SIZE-IMP", 0)

/* Arithmetic overflow in calculation */
COB_EXCEPTION  (COB_EC_CODE (0x10, 4), COB_EC_SIZE_OVERFLOW,
		"EC-SIZE-OVERFLOW", 1)

/* Significant digits truncated in store */
COB_EXCEPTION  (COB_EC_CODE (0x10, 5), COB_EC_SIZE_TRUNCATION,
		"EC-SIZE-TRUNCATION", 1)

/* Floating-point underflow */
COB_EXCEPTION  (COB_EC_CODE (0x10, 6), COB_EC_SIZE_UNDERFLOW,
		"EC-SIZE-UNDERFLOW", 1)

/* Division by zero */
COB_EXCEPTION  (COB_EC_CODE (0x10, 7), COB_EC_SIZE_ZERO_DIVIDE,
		"EC-SIZE-ZERO-DIVIDE", 1)


/* SORT or MERGE exception */
COB_EXCEPTION  (COB_EC_GROUP (0x11), COB_EC_SORT_MERGE,
		"EC-SORT-MERGE", 0)

/* File SORT or MERGE executed when one is already active */
COB_EXCEPTION  (COB_EC_CODE (0x11, 1), COB_EC_SORT_MERGE_ACTIVE,
		"EC-SORT-MERGE-ACTIVE", 1)

/* USING or GIVING file is open upon execution of a SORT or MERGE */
COB_EXCEPTION  (COB_EC_CODE (0x11, 2), COB_EC_SORT_MERGE_FILE_OPEN,
		"EC-SORT-MERGE-FILE-OPEN", 1)

/* Implementation-defined SORT or MERGE exception */
COB_EXCEPTION  (COB_EC_CODE (0x11, 3), COB_EC_SORT_MERGE_IMP,
		"EC-SORT-MERGE-IMP", 0)

/* RELEASE record too long or too short */
COB_EXCEPTION  (COB_EC_CODE (0x11, 4), COB_EC_SORT_MERGE_RELEASE,
		"EC-SORT-MERGE-RELEASE", 1)

/* RETURN executed when at end condition exists */
COB_EXCEPTION  (COB_EC_CODE (0x11, 5), COB_EC_SORT_MERGE_RETURN,
		"EC-SORT-MERGE-RETURN", 1)

/* Sequence error on MERGE USING file */
COB_EXCEPTION  (COB_EC_CODE (0x11, 6), COB_EC_SORT_MERGE_SEQUENCE,
		"EC-SORT-MERGE-SEQUENCE", 1)


/* Storage allocation exception */
COB_EXCEPTION  (COB_EC_GROUP (0x12), COB_EC_STORAGE,
		"EC-STORAGE", 0)

/* Implementation-defined storage allocation exception */
COB_EXCEPTION  (COB_EC_CODE (0x12, 1), COB_EC_STORAGE_IMP,
		"EC-STORAGE-IMP", 0)

/* The data-pointer specified in a FREE statement does not identify
   currently allocated storage */
COB_EXCEPTION  (COB_EC_CODE (0x12, 2), COB_EC_STORAGE_NOT_ALLOC,
		"EC-STORAGE-NOT-ALLOC", 0)

/* The amount of storage requested by an ALLOCATE statement is not available */
COB_EXCEPTION  (COB_EC_CODE (0x12, 3), COB_EC_STORAGE_NOT_AVAIL,
		"EC-STORAGE-NOT-AVAIL", 0)


/* User-defined exception condition */
/* Only valid in TURN directive + RAISE + EXIT PROGRAM / GOBACK */
COB_EXCEPTION  (COB_EC_GROUP (0x13), COB_EC_USER,
		"EC-USER", 0)


/* VALIDATE exception */
COB_EXCEPTION  (COB_EC_GROUP (0x14), COB_EC_VALIDATE,
		"EC-VALIDATE", 0)

/* VALIDATE content error */
COB_EXCEPTION  (COB_EC_CODE (0x14, 1), COB_EC_VALIDATE_CONTENT,
		"EC-VALIDATE-CONTENT", 0)

/* VALIDATE format error */
COB_EXCEPTION  (COB_EC_CODE (0x14, 2), COB_EC_VALIDATE_FORMAT,
		"EC-VALIDATE-FORMAT", 0)

/* Implementation-defined VALIDATE exception */
COB_EXCEPTION  (COB_EC_CODE (0x14, 3), COB_EC_VALIDATE_IMP,
		"EC-VALIDATE-IMP", 0)

/* VALIDATE relation error */
COB_EXCEPTION  (COB_EC_CODE (0x14, 4), COB_EC_VALIDATE_RELATION,
		"EC-VALIDATE-RELATION", 0)

/* VARYING clause expression non-integer (COBOL2014) */
COB_EXCEPTION  (COB_EC_CODE (0x14, 5), COB_EC_VALIDATE_VARYING,
		"EC-VALIDATE-VARYING", 1)


/* XML exception  (nonstandard) */
COB_EXCEPTION  (COB_EC_GROUP (0x16), COB_EC_XML,
		"EC-XML", 0)

/* XML encoding mismatch with CODE-SET */
COB_EXCEPTION  (COB_EC_CODE (0x16, 1), COB_EC_XML_CODESET,
		"EC-XML-CODESET", 1)

/* XML character cannot be encoded according to CODE-SET */
COB_EXCEPTION  (COB_EC_CODE (0x16, 2), COB_EC_XML_CODESET_CONVERSION,
		"EC-XML-CODESET-CONVERSION", 1)

/* XML */
COB_EXCEPTION  (COB_EC_CODE (0x16, 3), COB_EC_XML_COUNT,
		"EC-XML-COUNT", 1)

/* XML */
COB_EXCEPTION  (COB_EC_CODE (0x16, 4), COB_EC_XML_DOCUMENT_TYPE,
		"EC-XML-DOCUMENT-TYPE", 1)

/* XML */
COB_EXCEPTION  (COB_EC_CODE (0x16, 5), COB_EC_XML_IMPLICIT_CLOSE,
		"EC-XML-IMPLICIT-CLOSE", 1)

/* XML */
COB_EXCEPTION  (COB_EC_CODE (0x16, 6), COB_EC_XML_INVALID,
		"EC-XML-INVALID", 1)

/* XML */
COB_EXCEPTION  (COB_EC_CODE (0x16, 7), COB_EC_XML_NAMESPACE,
		"EC-XML-NAMESPACE", 1)

/* XML */
COB_EXCEPTION  (COB_EC_CODE (0x16, 8), COB_EC_XML_STACKED_OPEN,
		"EC-XML-STACKED-OPEN", 1)

/* XML */
COB_EXCEPTION  (COB_EC_CODE (0x16, 9), COB_EC_XML_RANGE,
		"EC-XML-RANGE", 1)

/* XML */
COB_EXCEPTION  (COB_EC_CODE (0x16, 16), COB_EC_XML_IMP,
		"EC-XML-IMP", 1)


/* JSON exception */
COB_EXCEPTION  (COB_EC_GROUP (0x17), COB_EC_JSON,
		"EC-JSON", 0)

/* JSON */
COB_EXCEPTION  (COB_EC_CODE (0x17, 16), COB_EC_JSON_IMP,
		"EC-JSON-IMP", 1)


#ifdef DUMMY_ENUM
	/* dummy-definition for lsp-supported editors */
		DUMMY_END
	};
#endif
