AT_SETUP([Wrong CLASS prototype])
AT_KEYWORDS([OOP])

AT_DATA([prog.cob], [
        FUNCTION-ID. fun.
        DATA DIVISION.
        LINKAGE SECTION.
        77 X PIC 9.
        PROCEDURE DIVISION RETURNING X.
             MOVE 0 TO X
             GOBACK.
        END FUNCTION fun.

        PROGRAM-ID. prog.
        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.
        REPOSITORY.
            CLASS C AS "fun".
        DATA DIVISION.
        WORKING-STORAGE SECTION.
            01 O USAGE OBJECT REFERENCE C.
        PROCEDURE DIVISION.
            INVOKE C "MyMethod".
            INVOKE O "MyMethod".
        END PROGRAM prog.
