AT_SETUP([CLASS-ID and INTERFACE-ID Syntax Checks])
AT_KEYWORDS([OOP])

AT_DATA([prog1.cob], [
        IDENTIFICATION DIVISION.
        INTERFACE-ID. MyFactoryInterface.
        END INTERFACE MyFactoryInterface.

        INTERFACE-ID. MyInterface.
        END INTERFACE MyInterface.

        CLASS-ID. MyBaseClass.
        FACTORY.
                IMPLEMENTS MyFactoryInterface.
        END FACTORY.
        OBJECT.
                DATA DIVISION.
                WORKING-STORAGE SECTION.
                    01 data-name PIC 9(2).
                PROCEDURE DIVISION.
                METHOD-ID. MyMethod IS FINAL.
                END METHOD MyMethod.

                METHOD-ID. GET PROPERTY data-name.
                END METHOD.

                METHOD-ID. SET PROPERTY data-name.
                END METHOD.
        END OBJECT.
        END CLASS MyBaseClass.

        CLASS-ID. MyDerivedClass
        INHERITS FROM MyBaseClass
                        MyBaseClass
                        MyUnknownClass
                        MyDerivedClass.
        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.
        REPOSITORY.
                CLASS MyBaseClass AS "MyKnownClass"
                INTERFACE MyInterface.
        FACTORY.
        END FACTORY.
        END CLASS MyDerivedClass.
])

